# Where the SQLite file lives (default: ./data/finance.db)
FINANCE_DB=./data/finance.db

# Encrypts Plaid access tokens at rest. If unset, a random key is generated into data/secret.key.
FINANCE_SECRET_KEY=

# Plaid: get keys at https://dashboard.plaid.com. Start with sandbox; use production for real accounts.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# How often the server pulls new transactions.
PLAID_SYNC_INTERVAL_HOURS=6
# Optional public URL for instant updates, e.g. https://<your-tunnel>/api/plaid/webhook
PLAID_WEBHOOK_URL=
# Set to false to leave Plaid-synced transactions uncategorized unless a rule matches.
PLAID_AUTO_CATEGORIZE=true
